# =============================================================================
# V-HUB — biến môi trường (mẫu)
# Không commit file .env thật. Trên Cloudflare Worker, các biến dưới đây được
# khai báo dưới dạng SECRET của ứng dụng (cùng tên), không phải file .env.
# Website chạy đầy đủ tính năng khi thiếu mọi biến tuỳ chọn bên dưới.
# =============================================================================

# --- Bắt buộc để vào trang quản trị -----------------------------------------
ADMIN_PASSWORD=

# --- Tuỳ chọn: nhận lead qua webhook/CRM ------------------------------------
# LEAD_WEBHOOK_URL=https://hooks.example.com/vhub-lead
# CRM_WEBHOOK_URL=https://crm.example.com/api/v1/leads
# CRM_API_KEY=

# --- Tuỳ chọn: Zalo OA (nhắc lịch, thông báo lead) --------------------------
# ZALO_OA_ACCESS_TOKEN=
# ZALO_TEMPLATE_ID=

# --- Tuỳ chọn: API KOCViet (định danh nhà sáng tạo) -------------------------
# KOCVIET_API_URL=https://api.kocviet.vn
# KOCVIET_API_KEY=

# --- Tuỳ chọn: trợ lý AI (OpenAI-compatible) --------------------------------
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1/chat/completions
# AI_MODEL=gpt-4o-mini

# --- Tuỳ chọn: đo lường (nhúng ở client, đặt trong secret để inject) --------
# GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# META_PIXEL_ID=
# TIKTOK_PIXEL_ID=

# --- Thông tin công khai có thể sửa trong src/lib/catalog-site.js ------------
# URL ứng dụng KOCViet: ORG.kocvietAppUrl (mặc định https://kocviet.vn/dang-ky)
# Hotline, Zalo OA, email, địa chỉ, giờ làm việc: ORG.*
#
# Lưu ý đồng bộ: phía máy chủ dùng bản tóm tắt server/lib/content-mirror.js
# (seed lịch live, giá thuê studio, ngữ cảnh trợ lý AI). Khi đổi giá studio trong
# src/lib/catalog-studios.js hoặc ngày Chợ Phiên trong src/lib/catalog-provinces.js,
# cập nhật mirror tương ứng để bước kiểm tra phía server khớp giao diện.
#
# Font: Google Fonts tải qua CSS; nếu môi trường chặn cross-origin, website tự dùng
# font hệ thống. Production nên tự host woff2 trong /styles/fonts.
